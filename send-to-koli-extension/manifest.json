{
  "manifest_version": 3,
  "name": "Send to Koli",
  "version": "2.1.0",
  "description": "Right-click a YouTube channel/video link (or any selected text) and send it straight to your Koli worksheet.",
  "permissions": ["contextMenus", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send to Koli — status & activity",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
